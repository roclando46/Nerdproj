FROM node:22-slim
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy full monorepo so workspace packages resolve
COPY . .

# Install all dependencies from monorepo root
RUN npm ci

# Generate Prisma client
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma

# Build API and its workspace dependencies
RUN npx turbo run build --filter=@dcs/api...

# Run migrations directly (bypass turbo to ensure DATABASE_URL is passed through)
# then start the server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma && node apps/api/dist/server.js"]
