# =============================================================================
# Digital Club Secretary — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dcs_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_STRONG_PASSWORD
POSTGRES_DB=digital_club_secretary
DATABASE_URL=postgresql://dcs_user:CHANGE_ME_LOCAL_STRONG_PASSWORD@localhost:5432/digital_club_secretary

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_LOCAL_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LOCAL_REDIS_PASSWORD@localhost:6379

# ─── MinIO (local S3-compatible storage) ─────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_12CHARS
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD_12CHARS
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_BUCKET=dcs-documents
S3_REGION=eu-west-2

# ─── Auth0 ────────────────────────────────────────────────────────────────────
# From: manage.auth0.com > Applications > Your SPA
AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_AUDIENCE=https://api.digitalclubsecretary.co.uk
# Web app only
AUTH0_CLIENT_ID=CHANGE_ME_AUTH0_CLIENT_ID

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── SendGrid ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.CHANGE_ME
EMAIL_FROM=noreply@digitalclubsecretary.co.uk
EMAIL_FROM_NAME=Digital Club Secretary

# ─── Security ─────────────────────────────────────────────────────────────────
# AES-256 key for DBS certificate number encryption (32 bytes = 64 hex chars)
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTER_KEY_HERE_FOR_AES256

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
